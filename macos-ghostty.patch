+        let view = Ghostty.SurfaceView(ghosttyApp, baseConfig: config)
+        untrackedPimSurface = view
+        pimForegroundSurface = view
+        pimForegroundSession = nil
+        pimPendingSession = nil
+        pimSwitchWorkItem?.cancel()
+        currentPimSession = nil
+        replaceSurfaceTree(
+            .init(view: view),
+            moveFocusTo: view,
+            moveFocusFrom: focusedSurface,
+            registerUndo: false)
+    }
