+        /// Submit a Pim session switch without blocking AppKit on libghostty input.
+        nonisolated func sendPimResume(_ text: String) {
+            let surface = self.surface
+            Self.pimInputQueue.async {
+                let length = text.utf8CString.count
+                guard length > 1 else { return }
+                text.withCString { ptr in
+                    ghostty_surface_text(surface, ptr, UInt(length - 1))
+                }
+            }
+        }
+
+        /// Send Pim focus state without blocking AppKit on libghostty input.
+        nonisolated func sendPimFocus(_ focused: Bool) {
+            let surface = self.surface
+            Self.pimInputQueue.async {
+                ghostty_surface_set_focus(surface, focused)
+            }
+        }
+
