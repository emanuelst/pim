+        // Never create a burst of hidden AppKit/Metal surfaces in one loop.
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            if self.pimSurfaces[session.id] == nil {
+                self.pimSurfaces[session.id] = self.makePimSurface(session, app: ghosttyApp, background: true)
+            }
+            self.pimBackgroundStartInFlight = false
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) { [weak self] in
+                self?.startKeptPimSessions()
+            }
+        }
+    }
+
+    private func newPimChat() {
+        guard let ghosttyApp = ghostty.app else { return }
+        var config = Ghostty.SurfaceConfiguration()
+        config.workingDirectory = FileManager.default.homeDirectoryForCurrentUser.path
+        config.command = PimSessionStore.launchCommand()
