+            // Loading is part of the terminal surface, not a floating panel.
+            .background(appearance.backgroundColor.opacity(appearance.backgroundOpacity))
+            .transition(.opacity)
+            .animation(.easeOut(duration: 0.15), value: store.switchingTo)
+        }
+    }
