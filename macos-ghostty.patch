index 0000000..9e12db8
--- /dev/null
+++ b/macos/Sources/Features/Pim/PimSession.swift
@@ -0,0 +1,161 @@
+import Foundation
+import SwiftUI
+
+struct PimSession: Identifiable, Hashable {
+    let id: URL
+    let cwd: String
+    let name: String?
+    let title: String?
+    let modified: Date
+
+    var displayName: String {
+        name ?? title ?? "Untitled session"
+    }
+}
+
+@MainActor
+final class PimSessionStore: ObservableObject {
+    @Published private(set) var sessions: [PimSession] = []
+    private var timer: Timer?
+
+    init() {
+        refresh()
+        timer = Timer.scheduledTimer(withTimeInterval: 2, repeats: true) { [weak self] _ in
+            Task { @MainActor [weak self] in self?.refresh() }
+        }
+    }
+
+    deinit {
+        timer?.invalidate()
+    }
+
+    func refresh() {
+        sessions = Self.loadSessions()
+    }
+
+    static func loadSessions() -> [PimSession] {
+        let root = FileManager.default.homeDirectoryForCurrentUser
+            .appendingPathComponent(".pi/agent/sessions")
+        guard let enumerator = FileManager.default.enumerator(
+            at: root,
+            includingPropertiesForKeys: [.contentModificationDateKey],
+            options: [.skipsHiddenFiles]
+        ) else { return [] }
+
+        return enumerator.compactMap { item -> PimSession? in
+            guard let url = item as? URL, url.pathExtension == "jsonl" else { return nil }
+            return read(url)
+        }.sorted { $0.modified > $1.modified }
+    }
+
+    static func initialConfiguration() -> Ghostty.SurfaceConfiguration {
+        var config = Ghostty.SurfaceConfiguration()
+        let cwd = FileManager.default.currentDirectoryPath
+        config.workingDirectory = cwd
+        config.command = if let session = loadSessions().first(where: { $0.cwd == cwd }) {
+            launchCommand(for: session)
+        } else {
+            launchCommand()
+        }
+        return config
+    }
+
+    static func launchCommand(for session: PimSession) -> String {
+        "\(quote(piExecutable)) --session \(quote(session.id.path))"
+    }
+
+    static func launchCommand() -> String {
+        quote(piExecutable)
+    }
+
+    private static var piExecutable: String {
+        if let configured = ProcessInfo.processInfo.environment["PIM_PI_PATH"],
+           FileManager.default.isExecutableFile(atPath: configured) {
+            return configured
+        }
+        let home = FileManager.default.homeDirectoryForCurrentUser.path
+        let candidates = [
+            "\(home)/Library/pnpm/bin/pi",
+            "\(home)/.bun/bin/pi",
+            "/opt/homebrew/bin/pi",
+            "/usr/local/bin/pi",
+        ]
+        return candidates.first(where: { FileManager.default.isExecutableFile(atPath: $0) }) ?? "pi"
+    }
+
+    private static func read(_ url: URL) -> PimSession? {
+        guard let data = try? Data(contentsOf: url) else { return nil }
+        var cwd: String?
+        var name: String?
+        var title: String?
+
+        for line in String(decoding: data, as: UTF8.self).split(separator: "\n") {
+            guard let object = try? JSONSerialization.jsonObject(with: Data(line.utf8)) as? [String: Any],
+                  let type = object["type"] as? String else { continue }
+            if type == "session", cwd == nil {
+                cwd = object["cwd"] as? String
+            } else if type == "session_info" {
+                name = object["name"] as? String
+            } else if type == "message", title == nil,
+                      let message = object["message"] as? [String: Any],
+                      message["role"] as? String == "user" {
+                if let text = message["content"] as? String {
+                    title = text.split(whereSeparator: { $0.isWhitespace }).joined(separator: " ")
+                }
+            }
+        }
+
+        guard let cwd else { return nil }
+        let modified = (try? url.resourceValues(forKeys: [.contentModificationDateKey]).contentModificationDate)
+            ?? Date.distantPast
+        return PimSession(id: url, cwd: cwd, name: name, title: title, modified: modified)
+    }
+
+    private static func quote(_ value: String) -> String {
+        "'" + value.replacingOccurrences(of: "'", with: "'\\''") + "'"
+    }
+}
+
+struct PimSidebar: View {
+    @ObservedObject var store: PimSessionStore
+    @State private var selection: PimSession.ID?
+    let onOpen: (PimSession) -> Void
+    let onNew: () -> Void
+
+    var body: some View {
+        VStack(spacing: 0) {
+            HStack {
+                Text("Chats")
+                    .font(.headline)
+                Spacer()
+                Button(action: onNew) {
+                    Image(systemName: "plus")
+                }
+                .buttonStyle(.borderless)
+                .help("New Chat")
+            }
+            .padding(.horizontal, 12)
+            .padding(.vertical, 10)
+
+            List(store.sessions, selection: $selection) { session in
+                VStack(alignment: .leading, spacing: 3) {
+                    Text(session.displayName)
+                        .lineLimit(1)
+                    Text(session.cwd)
+                        .font(.caption)
+                        .foregroundStyle(.secondary)
+                        .lineLimit(1)
+                }
+                .padding(.vertical, 3)
+                .tag(session.id)
+            }
+            .listStyle(.sidebar)
+            .onSubmit {
+                guard let selection,
+                      let session = store.sessions.first(where: { $0.id == selection }) else { return }
+                onOpen(session)
+            }
+        }
+        .frame(minWidth: 230, idealWidth: 280, maxWidth: 340)
+    }
+}
