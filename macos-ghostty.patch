+            .transition(.opacity)
+        } else if let loadingID = store.switchingTo {
+            let loadingName = store.sessions
+                .first(where: { $0.id == loadingID })
+                .map { store.displayName(for: $0) } ?? "chat"
+            VStack(spacing: 12) {
