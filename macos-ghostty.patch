+    private func openPimSession(_ session: PimSession) {
+        // Explicitly kept-active sessions have their own process and surface.
+        // Normal history navigation reuses the one foreground Pi process so a
+        // click never has to construct a new AppKit/Metal surface.
+        if let cached = pimSurfaces[session.id], !cached.processExited {
+            showPimSurface(cached, for: session)
+            return
+        }
+        requestPimSession(session)
+    }
+
+    private func capturePimForegroundSurfaceIfNeeded() {
+        guard pimForegroundSurface == nil,
+              let surface = focusedSurface,
+              !surface.processExited else { return }
+        pimForegroundSurface = surface
+        pimForegroundSession = currentPimSession
+    }
+
+    private func foregroundPimSurface() -> Ghostty.SurfaceView? {
+        capturePimForegroundSurfaceIfNeeded()
+        guard let surface = pimForegroundSurface, !surface.processExited else { return nil }
+        return surface
+    }
+
+    private func scheduleInitialPimResume() {
+        let cwd = FileManager.default.currentDirectoryPath
+        guard currentPimSession == nil,
+              pimForegroundSession == nil,
+              let session = pimSessionStore.sessions.first(where: { $0.cwd == cwd }) else { return }
+        requestPimSession(session)
+    }
+
+    private func requestPimSession(_ session: PimSession) {
+        pimPendingSession = session
+        pimSwitchWorkItem?.cancel()
+        let workItem = DispatchWorkItem { [weak self] in
