+    private func retainCurrentPimSurfaceIfNeeded() {
+        guard let focusedSurface else { return }
+        if let pimForegroundSurface, focusedSurface === pimForegroundSurface {
+            if let currentSession = currentPimSession ?? pimSessionStore.activeSession {
+                pimSurfaces[currentSession] = focusedSurface
+            }
+            return
+        }
+        if let currentSession = currentPimSession ?? pimSessionStore.activeSession {
+            pimSurfaces[currentSession] = focusedSurface
+        } else {
+            untrackedPimSurface = focusedSurface
+        }
+    }
+
+    private func togglePimActive(_ session: PimSession) {
+        if pimSessionStore.isKeptActive(session) {
+            if session.id == currentPimSession || session.id == pimSessionStore.activeSession {
+                retainCurrentPimSurfaceIfNeeded()
+            } else if pimSurfaces[session.id] == nil, let ghosttyApp = ghostty.app {
+                pimSurfaces[session.id] = makePimSurface(session, app: ghosttyApp, background: true)
