+    private func openPimSession(_ session: PimSession) {
+        let currentSession = currentPimSession ?? pimSessionStore.activeSession
+        if currentSession == session.id { return }
+
+        retainCurrentPimSurfaceIfNeeded()
+        if let cached = pimSurfaces[session.id], !cached.processExited {
+            showPimSurface(cached, for: session)
+            return
+        }
+
+        if let currentSession,
+           !pimSessionStore.isKeptActivePath(currentSession),
+           let surface = focusedSurface?.surfaceModel,
+           let focusedSurface,
+           !focusedSurface.processExited {
+            let encoded = Data(session.id.path.utf8).base64EncodedString()
+            surface.sendText("/pim-resume \(encoded)\n")
+            currentPimSession = session.id
+            return
+        }
+
+        guard let ghosttyApp = ghostty.app else { return }
+        let view = makePimSurface(session, app: ghosttyApp, background: false)
+        if pimSessionStore.isKeptActive(session) { pimSurfaces[session.id] = view }
+        showPimSurface(view, for: session)
+    }
+
+    private func makePimSurface(_ session: PimSession, app: ghostty_app_t, background: Bool) -> Ghostty.SurfaceView {
+        var config = Ghostty.SurfaceConfiguration()
+        config.workingDirectory = session.cwd
+        config.command = PimSessionStore.launchCommand(for: session)
+        if background { config.environmentVariables["PIM_BACKGROUND"] = "1" }
+        return Ghostty.SurfaceView(app, baseConfig: config)
+    }
+
+    private func showPimSurface(_ view: Ghostty.SurfaceView, for session: PimSession) {
+        currentPimSession = session.id
+        replaceSurfaceTree(.init(view: view), moveFocusTo: view, moveFocusFrom: focusedSurface)
+    }
+
+    private func retainCurrentPimSurfaceIfNeeded() {
+        guard let currentSession = currentPimSession ?? pimSessionStore.activeSession,
+              pimSessionStore.isKeptActivePath(currentSession),
+              let focusedSurface else { return }
+        pimSurfaces[currentSession] = focusedSurface
+    }
+
+    private func togglePimActive(_ session: PimSession) {
+        if pimSessionStore.isKeptActive(session) {
+            if session.id == currentPimSession || session.id == pimSessionStore.activeSession {
+                retainCurrentPimSurfaceIfNeeded()
+            } else if pimSurfaces[session.id] == nil, let ghosttyApp = ghostty.app {
+                pimSurfaces[session.id] = makePimSurface(session, app: ghosttyApp, background: true)
+            }
+        } else if session.id != currentPimSession {
+            pimSurfaces.removeValue(forKey: session.id)
+        }
+    }
+
+    private func startKeptPimSessions() {
+        guard let ghosttyApp = ghostty.app else { return }
+        let visible = pimSessionStore.activeSession
+        if currentPimSession == nil { currentPimSession = visible }
+        for session in pimSessionStore.sessions where pimSessionStore.isKeptActive(session)
+            && session.id != visible && pimSurfaces[session.id] == nil {
+            pimSurfaces[session.id] = makePimSurface(session, app: ghosttyApp, background: true)
+        }
+    }
+
+    private func newPimChat() {
+        let panel = NSOpenPanel()
+        panel.canChooseFiles = false
+        panel.canChooseDirectories = true
+        panel.allowsMultipleSelection = false
+        panel.prompt = "New Chat"
+        guard let window else { return }
+        panel.beginSheetModal(for: window) { [weak self] response in
+            guard response == .OK, let path = panel.url?.path, let self else { return }
+            guard let ghosttyApp = self.ghostty.app else { return }
+            var config = Ghostty.SurfaceConfiguration()
+            config.workingDirectory = path
+            config.command = PimSessionStore.launchCommand()
+            self.retainCurrentPimSurfaceIfNeeded()
+            let view = Ghostty.SurfaceView(ghosttyApp, baseConfig: config)
+            self.currentPimSession = nil
+            self.replaceSurfaceTree(
+                .init(view: view),
+                moveFocusTo: view,
+                moveFocusFrom: self.focusedSurface)
+        }
+    }
